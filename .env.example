# ============================================================
# .env.example
# Copy this file to .env and fill in your values:
#     cp .env.example .env
#
# NEVER commit .env to Git — it contains real credentials.
# This file (.env.example) is safe to commit — no real values.
# ============================================================

# ─────────────────────────────────────────
# PostgreSQL Database
# ─────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=social_media_analytics
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# ─────────────────────────────────────────
# Application Settings
# ─────────────────────────────────────────
APP_ENV=development
APP_DEBUG=True

# ─────────────────────────────────────────
# Docker PostgreSQL (different port to avoid
# conflict with local PostgreSQL install)
# ─────────────────────────────────────────
# DB_HOST=localhost
# DB_PORT=5433
# DB_PASSWORD=your_docker_postgres_password_here
