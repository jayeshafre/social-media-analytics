# ── Database ──────────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=social_media_analytics
DB_USER=postgres
DB_PASSWORD=your_strong_password_here

# ── App ───────────────────────────────────────────────────────
APP_ENV=production
APP_DEBUG=false
API_VERSION=v1

# ── AI ────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# ── Redis ─────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL_SECONDS=3600

# ── Security ──────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=key1_here,key2_here

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT=20
RATE_LIMIT_AGENTS=10
RATE_LIMIT_ML=30

# ── Caching ───────────────────────────────────────────────────
CACHE_ENABLED=true
CACHE_TTL_SECONDS=1800